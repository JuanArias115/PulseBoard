COMPOSE_PROJECT_NAME=pulseboard
PULSEBOARD_ENVIRONMENT=Development
PULSEBOARD_TIMEZONE=Europe/Vienna
PULSEBOARD_CORS_ORIGINS=http://localhost:4200,https://pulseboard.juanariasdev.com
PULSEBOARD_AUTO_MIGRATE=true

PULSEBOARD_POSTGRES_HOST=pulseboard-db
PULSEBOARD_POSTGRES_PORT=5432
PULSEBOARD_POSTGRES_DB=pulseboard
PULSEBOARD_POSTGRES_USER=pulseboard
PULSEBOARD_POSTGRES_PASSWORD=replace-with-a-new-password
ConnectionStrings__Default=Host=pulseboard-db;Port=5432;Database=pulseboard;Username=pulseboard;Password=replace-with-a-new-password

JWT__ISSUER=PulseBoard
JWT__AUDIENCE=PulseBoard
JWT__SIGNING_KEY=replace-with-a-long-random-secret

IMAGE_TAG=local
GHCR_OWNER=juanarias115
